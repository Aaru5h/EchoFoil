# ---------------------------------------------------------------------------
# EchoFoil environment variables
# Copy to .env and fill in. Only DATABASE_URL, AUTH_SECRET and
# NEXT_PUBLIC_SITE_URL are required to boot; everything else degrades
# gracefully (see lib/env.ts).
# ---------------------------------------------------------------------------

# --- Required ---
# Postgres connection string (Neon / Supabase / local). Pooled URL for runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/echofoil?schema=public"
# Direct (non-pooled) URL, used by prisma migrate. Optional for local Postgres.
DIRECT_URL=""
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin, no trailing slash. Used for canonicals, sitemap, OG images, emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed admin (used by prisma/seed.ts only) ---
ADMIN_EMAIL="admin@echofoil.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- Google OAuth (optional: provider is hidden when unset) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Transactional email (optional: emails are logged to console when unset) ---
RESEND_API_KEY=""
EMAIL_FROM="EchoFoil <no-reply@echofoil.com>"
# Where contact/quote notifications are delivered.
EMAIL_TO_SALES="sales@echofoil.com"

# --- Image uploads (optional: admin upload falls back to URL paste when unset) ---
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (optional: in-memory fallback used when unset) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cloudflare Turnstile (optional: honeypot-only when unset) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Analytics (optional: GA4 only loads after cookie consent) ---
NEXT_PUBLIC_GA_ID=""
